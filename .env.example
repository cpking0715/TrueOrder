# 复制为 backend/.env（本机开发）或根目录 .env（docker compose）

# ---- docker compose 必填（无默认值，缺失即拒绝启动）----
# 数据库口令：请用强随机串，例如 `openssl rand -hex 24`（避免 @ : / 等需 URL 转义的字符）
POSTGRES_PASSWORD=
# API 令牌：生产必须设置，例如 `openssl rand -hex 32`
TRUEORDER_API_TOKEN=
# 可选：POSTGRES_USER / POSTGRES_DB（默认 trueorder）、POSTGRES_HOST_PORT（默认 5433，仅绑 127.0.0.1）、
# TRUEORDER_HTTP_PORT（默认 8000）

# ---- 本机开发（非 compose）----
TRUEORDER_DATABASE_URL=postgresql+psycopg://trueorder:trueorder@localhost:5433/trueorder
TRUEORDER_SAMPLE_MODE=true

# ---- 业务配置 ----
TRUEORDER_COMPANY_ADDRESS=
TRUEORDER_SMTP_REPLY_TO=
TRUEORDER_AI_API_KEY=
TRUEORDER_HUNTER_API_KEY=
TRUEORDER_LOG_LEVEL=INFO
